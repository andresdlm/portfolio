---
import { siteConfig } from '../config/content';
---

<!-- Navigation Bar Component -->
<nav class="relative z-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a
        href="/"
        class="text-lg font-bold text-neutral-700 transition-colors hover:text-neutral-400 sm:text-xl dark:text-neutral-300 dark:hover:text-neutral-100"
      >
        {siteConfig.name}
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center space-x-4 sm:space-x-6 md:flex">
        <a
          href="/"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-400 sm:text-base dark:text-neutral-400 dark:hover:text-neutral-200"
          >Home</a
        >
        <a
          href="/posts/"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-400 sm:text-base dark:text-neutral-400 dark:hover:text-neutral-200"
          >Posts</a
        >
        <a
          href="/projects/"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-400 sm:text-base dark:text-neutral-400 dark:hover:text-neutral-200"
          >Projects</a
        >
        <a
          href="/about/"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-400 sm:text-base dark:text-neutral-400 dark:hover:text-neutral-200"
          >About</a
        >
        <button
          id="theme-toggle-desktop"
          class="rounded-full p-2 text-neutral-600 transition-colors hover:text-neutral-400 dark:text-neutral-400 dark:hover:text-neutral-200"
          title="Toggle theme"
        >
          <span
            class="theme-icon-light icon-mask hidden h-5 w-5"
            style="mask-image: url('/icons/sun.svg'); -webkit-mask-image: url('/icons/sun.svg');"
          ></span>
          <span
            class="theme-icon-dark icon-mask hidden h-5 w-5"
            style="mask-image: url('/icons/moon.svg'); -webkit-mask-image: url('/icons/moon.svg');"
          ></span>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="rounded-lg p-2 text-neutral-600 transition-colors hover:text-neutral-400 md:hidden dark:text-neutral-400 dark:hover:text-neutral-200"
        title="Toggle menu"
      >
        <span
          class="hamburger-icon icon-mask h-6 w-6"
          style="mask-image: url('/icons/menu.svg'); -webkit-mask-image: url('/icons/menu.svg');"
        ></span>
        <span
          class="close-icon icon-mask hidden h-6 w-6"
          style="mask-image: url('/icons/close.svg'); -webkit-mask-image: url('/icons/close.svg');"
        ></span>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden pb-4 md:hidden">
      <div class="flex flex-col space-y-3">
        <a
          href="/"
          class="rounded-lg px-3 py-2 text-base text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
          >Home</a
        >
        <a
          href="/posts/"
          class="rounded-lg px-3 py-2 text-base text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
          >Posts</a
        >
        <a
          href="/projects/"
          class="rounded-lg px-3 py-2 text-base text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
          >Projects</a
        >
        <a
          href="/about/"
          class="rounded-lg px-3 py-2 text-base text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
          >About</a
        >
        <button
          id="theme-toggle-mobile"
          class="flex items-center gap-2 rounded-lg px-3 py-2 text-base text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
          title="Toggle theme"
        >
          <span
            class="theme-icon-light icon-mask hidden h-5 w-5"
            style="mask-image: url('/icons/sun.svg'); -webkit-mask-image: url('/icons/sun.svg');"
          ></span>
          <span
            class="theme-icon-dark icon-mask hidden h-5 w-5"
            style="mask-image: url('/icons/moon.svg'); -webkit-mask-image: url('/icons/moon.svg');"
          ></span>
          <span>Toggle Theme</span>
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  function setupNavigation() {
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.querySelector('.hamburger-icon');
    const closeIcon = document.querySelector('.close-icon');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        const isOpen = !mobileMenu.classList.contains('hidden');

        if (isOpen) {
          mobileMenu.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        } else {
          mobileMenu.classList.remove('hidden');
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }
      });

      // Close mobile menu when clicking on a link
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        });
      });
    }

    // Theme toggle functionality
    function updateThemeIcons(isDark: boolean) {
      const allLightIcons = document.querySelectorAll('.theme-icon-light');
      const allDarkIcons = document.querySelectorAll('.theme-icon-dark');

      allLightIcons.forEach((icon) => {
        if (isDark) {
          icon.classList.add('hidden');
        } else {
          icon.classList.remove('hidden');
        }
      });

      allDarkIcons.forEach((icon) => {
        if (isDark) {
          icon.classList.remove('hidden');
        } else {
          icon.classList.add('hidden');
        }
      });
    }

    function toggleTheme() {
      const currentlyDark = document.documentElement.classList.contains('dark');
      const newTheme = currentlyDark ? 'light' : 'dark';

      if (currentlyDark) {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }

      updateThemeIcons(!currentlyDark);
      localStorage.setItem('theme', newTheme);
    }

    // Set initial theme icons
    const isDark = document.documentElement.classList.contains('dark');
    updateThemeIcons(isDark);

    // Setup theme toggle for desktop
    const themeToggleDesktop = document.getElementById('theme-toggle-desktop');
    if (themeToggleDesktop) {
      themeToggleDesktop.addEventListener('click', toggleTheme);
    }

    // Setup theme toggle for mobile
    const themeToggleMobile = document.getElementById('theme-toggle-mobile');
    if (themeToggleMobile) {
      themeToggleMobile.addEventListener('click', toggleTheme);
    }
  }

  // Initialize on page load
  setupNavigation();

  // Re-initialize on view transitions (if enabled in the future)
  document.addEventListener('astro:page-load', setupNavigation);
</script>
