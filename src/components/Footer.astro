---
import { siteConfig } from '../config/content';
---

<!-- Footer Component -->
<section class="relative text-gray-700">
  <div
    class="container mx-auto flex min-h-[40px] max-w-7xl flex-col items-center justify-center bg-transparent px-7 py-4 sm:min-h-[50px] sm:flex-row"
  >
    <a
      class="group relative z-30 flex h-5 items-center space-x-1.5 text-base font-semibold text-neutral-700 dark:text-neutral-300"
      href="/"
    >
      <span
        class="-translate-y-0.5 text-xl duration-300 ease-in-out group-hover:scale-[1.2] group-hover:-rotate-12"
        >✦</span
      >
      <span class="-translate-y-0.5">{siteConfig.name}</span>
    </a>
    <p
      class="mt-2 text-sm text-neutral-700 sm:mt-0 sm:ml-4 sm:border-l sm:border-neutral-700 sm:pl-4 dark:text-neutral-300 dark:sm:border-neutral-300"
    >
      © 2026 {siteConfig.name}. Todos los derechos reservados.
    </p>
    <span
      class="mt-2 inline-flex justify-center space-x-5 sm:mt-0 sm:ml-auto sm:justify-start"
    >
      <a
        href={siteConfig.social.linkedin}
        target="_blank"
        class="text-neutral-500 hover:text-neutral-400 dark:text-neutral-400 dark:hover:text-neutral-300"
      >
        <span class="sr-only">LinkedIn</span>
        <span
          class="icon-mask h-5 w-5"
          style="mask-image: url('/icons/linkedin.svg'); -webkit-mask-image: url('/icons/linkedin.svg');"
          aria-hidden="true"></span>
      </a>
      <a
        href={siteConfig.social.github}
        target="_blank"
        class="text-neutral-500 hover:text-neutral-400 dark:text-neutral-400 dark:hover:text-neutral-300"
      >
        <span class="sr-only">GitHub</span>
        <span
          class="icon-mask h-5 w-5"
          style="mask-image: url('/icons/github.svg'); -webkit-mask-image: url('/icons/github.svg');"
          aria-hidden="true"></span>
      </a>
      <a
        href={siteConfig.social.email}
        class="text-neutral-500 hover:text-neutral-400 dark:text-neutral-400 dark:hover:text-neutral-300"
      >
        <span class="sr-only">Email</span>
        <span
          class="icon-mask h-5 w-5"
          style="mask-image: url('/icons/email.svg'); -webkit-mask-image: url('/icons/email.svg');"
          aria-hidden="true"></span>
      </a>
    </span>
  </div>
</section>
