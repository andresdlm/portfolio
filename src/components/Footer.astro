---
import { siteConfig } from '../config/content';
---

<footer class="footer">
  <div class="footer-container">
    <a class="footer-brand" href="/">
      <span class="footer-brand-icon">✦</span>
      <span class="footer-brand-text">{siteConfig.name}</span>
    </a>

    <p class="footer-copyright">
      © 2026 {siteConfig.name}. Todos los derechos reservados.
    </p>

    <nav class="footer-social" aria-label="Redes sociales">
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="footer-social-link">
        <span class="sr-only">LinkedIn</span>
        <span class="footer-social-icon footer-social-icon-linkedin" aria-hidden="true"></span>
      </a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="footer-social-link">
        <span class="sr-only">GitHub</span>
        <span class="footer-social-icon footer-social-icon-github" aria-hidden="true"></span>
      </a>
      <a href={siteConfig.social.email} class="footer-social-link">
        <span class="sr-only">Email</span>
        <span class="footer-social-icon footer-social-icon-email" aria-hidden="true"></span>
      </a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    color: rgb(55 65 81);
  }

  .footer-container {
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 1rem 1.75rem;
    background: transparent;
  }

  .footer-brand {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: rgb(64 64 64);
    text-decoration: none;
  }

  .footer-brand-icon {
    transform: translateY(-0.125rem);
    font-size: 1.25rem;
    transition: transform 300ms ease-in-out;
  }

  .footer-brand:hover .footer-brand-icon {
    transform: translateY(-0.125rem) scale(1.2) rotate(-12deg);
  }

  .footer-brand-text {
    transform: translateY(-0.125rem);
  }

  .footer-copyright {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: rgb(64 64 64);
  }

  .footer-social {
    margin-top: 0.5rem;
    display: inline-flex;
    justify-content: center;
    gap: 1.25rem;
  }

  .footer-social-link {
    color: rgb(115 115 115);
    transition: color 200ms;
  }

  .footer-social-link:hover {
    color: rgb(163 163 163);
  }

  .footer-social-icon {
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    background-color: currentColor;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
  }

  .footer-social-icon-linkedin {
    mask-image: url('/icons/linkedin.svg');
    -webkit-mask-image: url('/icons/linkedin.svg');
  }

  .footer-social-icon-github {
    mask-image: url('/icons/github.svg');
    -webkit-mask-image: url('/icons/github.svg');
  }

  .footer-social-icon-email {
    mask-image: url('/icons/email.svg');
    -webkit-mask-image: url('/icons/email.svg');
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Dark mode */
  :global(.dark) .footer-brand,
  :global(.dark) .footer-copyright {
    color: rgb(212 212 212);
  }

  :global(.dark) .footer-social-link {
    color: rgb(163 163 163);
  }

  :global(.dark) .footer-social-link:hover {
    color: rgb(212 212 212);
  }

  /* Responsive */
  @media (min-width: 640px) {
    .footer-container {
      flex-direction: row;
      min-height: 50px;
    }

    .footer-copyright {
      margin-top: 0;
      margin-left: 1rem;
      padding-left: 1rem;
      border-left: 1px solid rgb(64 64 64);
    }

    :global(.dark) .footer-copyright {
      border-left-color: rgb(212 212 212);
    }

    .footer-social {
      margin-top: 0;
      margin-left: auto;
      justify-content: flex-start;
    }
  }
</style>
