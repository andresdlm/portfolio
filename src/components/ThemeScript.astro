---
// Theme initialization and toggle script
// This component should be included in the <head> of every page
---

<script is:inline>
  (function () {
    const savedTheme = localStorage.getItem('theme') || 'light';
    const prefersDark = window.matchMedia(
      '(prefers-color-scheme: dark)'
    ).matches;
    const initialTheme =
      savedTheme === 'system' ? (prefersDark ? 'dark' : 'light') : savedTheme;

    if (initialTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  })();
</script>

<script>
  function initTheme() {
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', (e) => {
        if (localStorage.getItem('theme') === 'system') {
          if (e.matches) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
      });
  }

  // Initialize on page load
  initTheme();

  // Re-initialize on view transitions (if enabled in the future)
  document.addEventListener('astro:page-load', initTheme);
</script>
