---
interface ExperienceItem {
  period: string;
  position: string;
  company: string;
  description: string;
}

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<div class="timeline">
  {
    items.map((item) => (
      <article class="timeline-item">
        <div class="timeline-item-content">
          <div class="timeline-item-icon">
            <span class="timeline-item-icon-svg" aria-hidden="true"></span>
          </div>
          <p class="timeline-item-period">
            {item.period}
          </p>
          <h3 class="timeline-item-position">
            {item.position}
          </h3>
          <p class="timeline-item-company">
            {item.company}
          </p>
          <p class="timeline-item-description">
            {item.description}
          </p>
        </div>
      </article>
    ))
  }
</div>

<style>
  .timeline {
    margin-left: 1.5rem;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .timeline-item {
    padding-bottom: 2.5rem;
    border-left: 1px solid rgb(229 229 229);
  }

  .timeline-item:last-child {
    border-left: none;
  }

  .timeline-item-content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-left: 3rem;
  }

  .timeline-item-icon {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    transform: translateX(-50%);
    border: 1px solid rgb(212 212 212);
    border-radius: 50%;
    background-color: white;
  }

  .timeline-item-icon-svg {
    display: inline-block;
    width: 2rem;
    height: 2rem;
    background-color: rgb(64 64 64);
    mask-image: url('/icons/code.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-image: url('/icons/code.svg');
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
  }

  .timeline-item-period {
    font-size: 0.75rem;
    font-weight: 400;
    color: rgb(163 163 163);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .timeline-item-position {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .timeline-item-company {
    margin-bottom: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .timeline-item-description {
    font-size: 0.875rem;
    font-weight: 300;
    color: rgb(82 82 82);
  }

  /* Dark mode */
  :global(.dark) .timeline-item {
    border-left-color: rgb(64 64 64);
  }

  :global(.dark) .timeline-item-icon {
    border-color: rgb(64 64 64);
    background-color: rgb(10 10 10);
  }

  :global(.dark) .timeline-item-icon-svg {
    background-color: rgb(212 212 212);
  }

  :global(.dark) .timeline-item-period {
    color: rgb(115 115 115);
  }

  :global(.dark) .timeline-item-position {
    color: rgb(245 245 245);
  }

  :global(.dark) .timeline-item-company {
    color: rgb(212 212 212);
  }

  :global(.dark) .timeline-item-description {
    color: rgb(163 163 163);
  }
</style>
