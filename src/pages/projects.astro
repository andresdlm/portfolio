---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillBadge from '../components/SkillBadge.astro';
import { projectsContent } from '../config/content.ts';
---

<BaseLayout
  title={projectsContent.meta.title}
  description={projectsContent.meta.description}
>
  <section class="relative z-20 mx-auto mt-32 mb-12 max-w-4xl px-7 lg:px-0">
    <div class="relative z-20 mx-auto w-full lg:mx-0">
      <h2
        class="text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl lg:text-4xl dark:text-neutral-100"
      >
        {projectsContent.title}
      </h2>
      <p
        class="mt-3 text-sm leading-6 text-neutral-600 sm:text-base sm:leading-7 lg:text-lg lg:leading-8 dark:text-neutral-400"
      >
        {projectsContent.description}
      </p>

      <div
        class="z-50 my-8 grid w-full grid-cols-1 items-stretch gap-7 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3"
      >
        {
          projectsContent.projects.map((project) => (
            <div class="group relative flex flex-col items-stretch rounded-2xl p-7 duration-300 ease-out sm:p-3">
              <span class="absolute inset-0 z-20 block h-full w-full rounded-2xl border border-dashed border-transparent bg-transparent duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border group-hover:border-dashed group-hover:border-neutral-300 group-hover:bg-white dark:group-hover:border-neutral-600 dark:group-hover:bg-neutral-950" />
              <span class="absolute inset-0 z-10 block h-full w-full rounded-2xl border border-dashed border-neutral-300 duration-300 ease-out group-hover:translate-x-1 group-hover:translate-y-1 dark:border-neutral-600" />
              <span class="relative z-30 block duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
                <span class="block w-full">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="aspect-[16/9] h-auto w-full rounded-lg object-cover"
                  />
                </span>
                <span class="mt-5 mb-1 block w-full px-1 sm:mt-3">
                  <span class="mb-2 flex items-center text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
                    <span>{project.title}</span>
                  </span>
                  <span class="mb-3 block text-sm text-neutral-600 dark:text-neutral-400">
                    {project.description}
                  </span>
                  {project.technologies && (
                    <div class="flex flex-wrap gap-1.5">
                      {project.technologies.map((tech) => (
                        <span class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}
                </span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
