---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillBadge from '../components/SkillBadge.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { aboutContent } from '../config/content.ts';
---

<BaseLayout
  title={aboutContent.meta.title}
  description={aboutContent.meta.description}
>
  <section class="relative z-20 mx-auto mt-24 mb-12 w-[896px]">
    <div class="relative z-20 mx-auto w-full lg:mx-0">
      <h2
        class="text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl lg:text-4xl dark:text-neutral-100"
      >
        {aboutContent.title}
      </h2>
      <div class="mt-3 flex flex-col gap-8 sm:mt-4 md:flex-row lg:mt-6">
        <div class="flex w-full flex-col md:w-1/2">
          <p
            class="text-sm leading-6 text-gray-600 sm:text-base sm:leading-7 lg:text-lg lg:leading-8 dark:text-neutral-400"
          >
            {aboutContent.description}
          </p>
          <div class="mt-auto flex flex-wrap gap-2 pt-4">
            {aboutContent.skills.map((skill) => <SkillBadge skill={skill} />)}
          </div>
        </div>
        <div class="flex w-full justify-end md:w-1/2">
          <div class="relative h-[360px] w-[360px]">
            <img
              src={aboutContent.image.src}
              alt={aboutContent.image.alt}
              class="h-full w-full rounded-xl object-cover"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="mt-20 flex flex-col md:flex-row">
      <div class="flex-1">
        <h2 class="mb-2 text-2xl font-bold dark:text-neutral-200">
          {aboutContent.experience.title}
        </h2>
        <ExperienceTimeline items={aboutContent.experience.items} />
      </div>

      <div class="ml-8 w-[360px]">
        <h2 class="mb-2 text-2xl font-bold dark:text-neutral-200">
          {aboutContent.connect.title}
        </h2>
        <div class="py-[30px]">
          <p
            class="text-sm leading-6 text-gray-600 sm:text-base sm:leading-7 lg:text-lg lg:leading-8 dark:text-neutral-400"
          >
            {aboutContent.connect.description}
            <a
              href={aboutContent.connect.email.href}
              class="text-indigo-600 underline"
            >
              {aboutContent.connect.email.text}
            </a>
            .
          </p>
        </div>

        <h2 class="mt-8 mb-2 text-2xl font-bold dark:text-neutral-200">
          {aboutContent.education.title}
        </h2>
        <div class="py-[30px]">
          {
            aboutContent.education.items.map((item) => (
              <div class="mb-4">
                <p class="text-xs tracking-widest text-neutral-400 uppercase dark:text-neutral-500">
                  {item.period}
                </p>
                <h3 class="text-base font-bold dark:text-neutral-100">
                  {item.degree}
                </h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  {item.institution}
                </p>
              </div>
            ))
          }
        </div>

        <h2 class="mt-8 mb-2 text-2xl font-bold dark:text-neutral-200">
          {aboutContent.languages.title}
        </h2>
        <div class="py-[30px]">
          {
            aboutContent.languages.items.map((item) => (
              <div class="mb-2 flex justify-between">
                <span class="text-sm font-medium dark:text-neutral-300">
                  {item.language}
                </span>
                <span class="text-sm text-neutral-600 dark:text-neutral-400">
                  {item.level}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
