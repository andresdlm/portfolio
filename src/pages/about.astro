---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillBadge from '../components/SkillBadge.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { aboutContent } from '../config/content.ts';
---

<BaseLayout
  title={aboutContent.meta.title}
  description={aboutContent.meta.description}
>
  <section
    class="relative z-20 mx-auto mt-16 mb-12 w-full max-w-6xl px-4 sm:mt-20 sm:px-6 lg:mt-24 lg:px-8"
  >
    <div class="relative z-20 mx-auto w-full">
      <h1
        class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl dark:text-neutral-100"
      >
        {aboutContent.title}
      </h1>
      <div class="mt-6 flex flex-col gap-8 sm:mt-8 lg:flex-row lg:gap-12">
        <div class="flex w-full flex-col lg:w-1/2">
          <p
            class="text-base leading-7 text-gray-600 sm:text-lg dark:text-neutral-400"
          >
            {aboutContent.description}
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {aboutContent.skills.map((skill) => <SkillBadge skill={skill} />)}
          </div>
        </div>
        <div class="flex w-full justify-center lg:w-1/2 lg:justify-end">
          <div class="relative h-64 w-64 sm:h-80 sm:w-80 lg:h-96 lg:w-96">
            <img
              src={aboutContent.image.src}
              alt={aboutContent.image.alt}
              class="h-full w-full rounded-xl object-cover shadow-lg"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-12 sm:mt-20 lg:flex-row lg:gap-16">
      <div class="flex-1">
        <h2
          class="mb-4 text-2xl font-bold sm:text-3xl lg:text-4xl dark:text-neutral-100"
        >
          {aboutContent.experience.title}
        </h2>
        <ExperienceTimeline items={aboutContent.experience.items} />
      </div>

      <div class="w-full space-y-12 lg:w-96">
        <div>
          <h2
            class="mb-4 text-2xl font-bold sm:text-3xl lg:text-4xl dark:text-neutral-100"
          >
            {aboutContent.connect.title}
          </h2>
          <p
            class="text-base leading-7 text-gray-600 sm:text-lg dark:text-neutral-400"
          >
            {aboutContent.connect.description}
            <a
              href={aboutContent.connect.email.href}
              class="text-indigo-600 underline hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300"
            >
              {aboutContent.connect.email.text}
            </a>
            .
          </p>
        </div>

        <div>
          <h2
            class="mb-4 text-2xl font-bold sm:text-3xl lg:text-4xl dark:text-neutral-100"
          >
            {aboutContent.education.title}
          </h2>
          <div class="space-y-6">
            {
              aboutContent.education.items.map((item) => (
                <div>
                  <p class="text-xs tracking-widest text-neutral-400 uppercase dark:text-neutral-500">
                    {item.period}
                  </p>
                  <h3 class="mt-1 text-lg font-bold sm:text-xl dark:text-neutral-100">
                    {item.degree}
                  </h3>
                  <p class="text-base text-neutral-600 dark:text-neutral-400">
                    {item.institution}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <h2
            class="mb-4 text-2xl font-bold sm:text-3xl lg:text-4xl dark:text-neutral-100"
          >
            {aboutContent.languages.title}
          </h2>
          <div class="space-y-3">
            {
              aboutContent.languages.items.map((item) => (
                <div class="flex justify-between">
                  <span class="text-base font-medium dark:text-neutral-300">
                    {item.language}
                  </span>
                  <span class="text-base text-neutral-600 dark:text-neutral-400">
                    {item.level}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
