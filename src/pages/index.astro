---
import HomeLayout from '../layouts/HomeLayout.astro';
import { siteConfig, homeContent } from '../config/content.ts';
---

<HomeLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="relative flex min-h-0 flex-1 flex-col pt-4">
    <main class="flex min-h-0 flex-grow flex-col">
      <div class="flex min-h-0 flex-1 items-center justify-center">
        <div
          class="mx-auto flex w-full max-w-5xl flex-row items-center justify-between gap-12 px-4 sm:px-6 lg:px-8"
        >
          <div class="w-[45%] text-left">
            <h1
              class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-100"
            >
              {homeContent.title}
            </h1>
            <p
              class="mt-3 text-lg leading-7 text-neutral-600 dark:text-neutral-400"
            >
              {homeContent.description}
            </p>
            <div class="mt-4 flex flex-row gap-4">
              <a
                class="group inline-flex cursor-pointer items-center gap-2 rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-all duration-300 hover:scale-105 hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200"
                href={homeContent.buttons.about.href}
                >{homeContent.buttons.about.text}<svg
                  class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
                ></a
              >
              <a
                class="group inline-flex cursor-pointer items-center gap-2 rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-900 transition-all duration-300 hover:scale-105 hover:bg-neutral-50 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700"
                href={homeContent.buttons.posts.href}
                >{homeContent.buttons.posts.text}<svg
                  class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
                ></a
              >
            </div>
          </div>
          <div
            class="relative z-20 flex w-[45%] items-center justify-center overflow-hidden bg-transparent"
          >
            <div
              class="relative overflow-hidden"
              style="width: min(700px, 45vw); height: min(700px, 70vh); max-width: 100%; max-height: 70vh;"
            >
              <img
                src={homeContent.images.light}
                alt="Tech Background"
                class="h-full w-full animate-[float_15s_ease-in-out_infinite] object-contain opacity-90 transition-transform duration-300 hover:scale-125 dark:hidden"
                style="max-width: 100%; max-height: 100%;"
              />

              <img
                src={homeContent.images.dark}
                alt="Tech Background Dark"
                class="hidden h-full w-full animate-[float_15s_ease-in-out_infinite] object-contain opacity-90 transition-transform duration-300 hover:scale-125 dark:block"
                style="max-width: 100%; max-height: 100%;"
              />
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</HomeLayout>
