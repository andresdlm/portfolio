---
import HomeLayout from '../layouts/HomeLayout.astro';
import { siteConfig, homeContent } from '../config/content.ts';
---

<HomeLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="relative flex min-h-0 flex-1 flex-col pt-4 md:pt-8">
    <main class="flex min-h-0 flex-grow flex-col">
      <div
        class="flex min-h-0 flex-1 items-center justify-center px-4 sm:px-6 lg:px-8"
      >
        <div
          class="mx-auto flex w-full max-w-6xl flex-col items-center justify-center gap-8 md:flex-row md:justify-between md:gap-12"
        >
          <div class="w-full text-center md:w-1/2 md:text-left">
            <h1
              class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl dark:text-neutral-100"
            >
              {homeContent.title}
            </h1>
            <p
              class="mt-4 text-base leading-7 text-neutral-600 sm:mt-6 sm:text-lg lg:text-xl dark:text-neutral-400"
            >
              {homeContent.description}
            </p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:gap-4 md:mt-8">
              <a
                class="group inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-neutral-900 px-5 py-3 text-sm font-medium text-white transition-all duration-300 hover:scale-105 hover:bg-neutral-800 sm:text-base dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200"
                href={homeContent.buttons.about.href}
              >
                {homeContent.buttons.about.text}
                <span
                  class="icon-mask h-4 w-4"
                  style="mask-image: url('/icons/arrow-right.svg'); -webkit-mask-image: url('/icons/arrow-right.svg');"
                  aria-hidden="true"></span>
              </a>
              <a
                class="group inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-neutral-300 bg-white px-5 py-3 text-sm font-medium text-neutral-900 transition-all duration-300 hover:scale-105 hover:bg-neutral-50 sm:text-base dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700"
                href={homeContent.buttons.posts.href}
              >
                {homeContent.buttons.posts.text}
                <span
                  class="icon-mask h-4 w-4"
                  style="mask-image: url('/icons/arrow-right.svg'); -webkit-mask-image: url('/icons/arrow-right.svg');"
                  aria-hidden="true"></span>
              </a>
            </div>
          </div>
          <div
            class="relative z-20 hidden w-full items-center justify-center overflow-hidden bg-transparent md:flex md:w-1/2"
          >
            <div
              class="relative overflow-hidden"
              style="width: min(500px, 100%); height: min(500px, 60vh); max-width: 100%; max-height: 60vh;"
            >
              <img
                src={homeContent.images.light}
                alt="Tech Background"
                class="h-full w-full animate-[float_15s_ease-in-out_infinite] object-contain opacity-90 transition-transform duration-300 hover:scale-125 dark:hidden"
              />
              <img
                src={homeContent.images.dark}
                alt="Tech Background Dark"
                class="hidden h-full w-full animate-[float_15s_ease-in-out_infinite] object-contain opacity-90 transition-transform duration-300 hover:scale-125 dark:block"
              />
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</HomeLayout>
